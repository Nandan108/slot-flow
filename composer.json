{
    "name": "nandan108/slot-flow",
    "description": "SlotFlow is a domain-neutral, deterministic engine for modeling and executing quantity flows across a multidimensional state space.",
    "type": "library",
    "license": [
        "GPL-2.0-or-later",
        "LicenseRef-SlotFlow-Commercial"
    ],
    "autoload": {
        "psr-4": {
            "Nandan108\\SlotFlow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "symfony/var-dumper": "^6.0 || ^7.0",
        "vimeo/psalm": "^6.12",
        "nunomaduro/collision": "^6.4",
        "friendsofphp/php-cs-fixer": "^3.92",
        "wikimedia/composer-merge-plugin": "^2.1",
        "phpdocumentor/shim": "^3.9"
    },
    "authors": [
        {
            "name": "Samuel de Rougemont",
            "email": "nandan108@gmail.com"
        }
    ],
    "scripts": {
        "cs-fix": "./vendor/bin/php-cs-fixer fix --allow-risky=yes --diff",
        "phpdoc": "./vendor/bin/phpdoc -c phpdoc.dist.xml",
        "psalm": "./vendor/bin/psalm",
        "test": "./vendor/bin/phpunit",
        "testAndCover": "./vendor/bin/phpunit --coverage-text --coverage-html coverage"
    },
    "config": {
        "allow-plugins": {
            "phpdocumentor/shim": true,
            "wikimedia/composer-merge-plugin": true
        }
    }
}
