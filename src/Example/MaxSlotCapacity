<?php

namespace Nandan108\SlotFlow\Example;

use Nandan108\SlotFlow as Inv;

final class MaxSlotCapacity implements Inv\Constraint
{
    public function __construct(
        private Inv\SlotKey $slot,
        private int $capacity
    ) {}

    #[\Override]
    public function limit(
        Inv\Inventory $inventory,
        Inv\MovementEdge $edge,
        int $requested
    ): int {
        if (!$edge->to || !$edge->to->equals($this->slot)) {
            return $requested;
        }

        $current = $inventory->get($this->slot);

        return max(0, min($requested, $this->capacity - $current));
    }
}

